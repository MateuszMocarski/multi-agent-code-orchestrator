# COMMON SETTINGS
ORCHESTRATOR_TARGET_REPO=/absolute/path/to/target-repository
ORCHESTRATOR_RUNTIME_DIR=/absolute/path/to/runtime
ORCHESTRATOR_DOCKER_IMAGE=your-agent-image:tag
ORCHESTRATOR_AGENT_BACKEND=opencode

# Optional common setting.
ORCHESTRATOR_MAX_REVIEW_ROUNDS=4

# OPENCODE SETTINGS (required when ORCHESTRATOR_AGENT_BACKEND=opencode)
ORCHESTRATOR_DEVELOPER_CONFIG=/absolute/path/to/developer-opencode.json
ORCHESTRATOR_REVIEWER_CONFIG=/absolute/path/to/reviewer-opencode.json

# CODEX SETTINGS (required when ORCHESTRATOR_AGENT_BACKEND=codex)
# This directory contains Codex authentication and config state. Keep it outside
# this checkout and the target repository. It is mounted only in Codex agent containers.
ORCHESTRATOR_CODEX_STATE_DIR=/absolute/path/to/codex-state
# Model choices are optional; Codex uses the configured default if omitted.
# ORCHESTRATOR_DEVELOPER_MODEL=
# ORCHESTRATOR_REVIEWER_MODEL=
